# Build products
build/
*.o
*.a
*.so

# Generated data. Regenerate deterministically:
#   build/race_eval --dump data/<name>
data/
out/
replays/
logs/
checkpoints/
wandb/

# raylib is downloaded into the pinned submodule by tools/build.sh
third_party/pufferlib/raylib-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.DS_Store
.vscode/
*.swp

# Credentials. Never commit. racewm/secrets.py reads secrets.env from the repo
# root; keep real values here and out of git.
secrets.env
.env
.env.*
*.pem

# Local run outputs and pod state
runs/

# Viewer captures (videos, screenshots): local only, see tools/moba_viz_capture.py
media/
# the paper's own figures media (small GIFs/PNGs referenced by docs/moba/*.md) are part of the artifact
!docs/moba/paper/media/

# dream-PPO policies live in s3://puffertank/moba/dream_policies/ (same relative paths)
results/moba/dream/**/*.pt

# credentials written onto pods by tools/pod.py: never commit
**/.s3_policy.json
**/.pod_secrets*
**/.s3_read_*.env
