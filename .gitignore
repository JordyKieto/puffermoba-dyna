# Build products
build/
*.o
*.a
*.so

# Generated data. Regenerate deterministically:
#   build/race_eval --dump data/<name>
data/
out/
replays/
logs/
checkpoints/
wandb/

# raylib is downloaded into the pinned submodule by tools/build.sh
third_party/pufferlib/raylib-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.DS_Store
.vscode/
*.swp

# Credentials. Never commit. racewm/secrets.py reads secrets.env from the repo
# root; keep real values here and out of git.
secrets.env
.env
.env.*
*.pem

# Local run outputs and pod state
runs/
